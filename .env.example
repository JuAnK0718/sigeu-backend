PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://host:port/database
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me
SIGEU_SEED_DEMO_USERS=true
SIGEU_JWT_SECRET=change-this-long-random-secret
SIGEU_JWT_EXPIRATION_SECONDS=86400
SIGEU_AUTH_REQUIRE_TOKEN=false
SIGEU_RATE_LIMIT_ENABLED=true
SIGEU_RATE_LIMIT_AUTH_PER_MINUTE=10
SIGEU_RATE_LIMIT_REPORTS_PER_MINUTE=20
SIGEU_RATE_LIMIT_API_PER_MINUTE=120
