PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://host:port/database
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me
SIGEU_SEED_DEMO_USERS=true
SIGEU_JWT_SECRET=change-this-long-random-secret
SIGEU_JWT_EXPIRATION_SECONDS=86400
SIGEU_AUTH_REQUIRE_TOKEN=false
SIGEU_RATE_LIMIT_ENABLED=true
SIGEU_RATE_LIMIT_AUTH_PER_MINUTE=10
SIGEU_RATE_LIMIT_REPORTS_PER_MINUTE=20
SIGEU_RATE_LIMIT_API_PER_MINUTE=120
SIGEU_WORKFLOW_ENABLED=true
SIGEU_WORKFLOW_RESOLVE_MINUTES=15
SIGEU_WORKFLOW_HIGH_PRIORITY_RESOLVE_MINUTES=10
SIGEU_WORKFLOW_DELETE_AFTER_RESOLVE_MINUTES=10
SIGEU_WORKFLOW_TICK_MS=60000
SIGEU_RESOURCES_POLICIA=30
SIGEU_RESOURCES_HOSPITAL=15
SIGEU_RESOURCES_BOMBEROS=8
